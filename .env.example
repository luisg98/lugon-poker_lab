# =====================================================================
# Lugon Poker Lab - Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# =====================================================================

# --- LLM Advisor Configuration ---
# Heuristic is the default offline engine (zero dependencies, <30ms latency).
# Set these only if using external or local LLM advisors:

# OpenAI / OpenAI-compatible endpoint (LM Studio, vLLM, llama.cpp, LocalAI)
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:1234/v1

# Google Gemini API
GEMINI_API_KEY=

# Ollama local runtime
OLLAMA_HOST=http://127.0.0.1:11434

# --- Database & Storage Paths ---
# Defaults to data/profiles.sqlite if omitted
LUGON_DB_PATH=data/profiles.sqlite

# --- Diagnostic & Logging ---
# LUGON_DEBUG=1
